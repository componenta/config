# Application
APP_NAME=Componenta
APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:secretkey123456789

# Cycle
DB_HOST=localhost
DB_PORT=3306
DB_NAME=Componenta_test
DB_USER=root
DB_PASSWORD="secret password"

# Cache
CACHE_DRIVER=redis
CACHE_DRIVERS=redis,memcached,file
CACHE_TTL=3600

# Boolean variations
FEATURE_ENABLED=yes
FEATURE_DISABLED=no
FLAG_ON=on
FLAG_OFF=off

# Numeric
RATE_LIMIT=100
RATE_FLOAT=3.14

# Quoted values
QUOTED_DOUBLE="Hello World"
QUOTED_SINGLE='No escape \n here'
ESCAPED_QUOTES="She said \"hello\""
MULTILINE="Line1\nLine2\tTabbed"

# Empty
EMPTY_VALUE=
